<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambiance Ultrawide" Width="1040" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FF1C1C21"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextDim" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="TextFaint" Color="#78FFFFFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Stroke" Color="#16FFFFFF"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFF8A3D" Offset="0"/>
      <GradientStop Color="#FFC04BFF" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- kenar cubugu ogesi -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bg" CornerRadius="6" Background="Transparent"/>
              <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{StaticResource Accent}" Visibility="Collapsed"/>
              <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#0FFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#16FFFFFF"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- acma/kapama anahtari -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="22" Background="Transparent">
              <Border x:Name="track" CornerRadius="11" Background="#14FFFFFF" BorderBrush="#8CFFFFFF" BorderThickness="1"/>
              <Ellipse x:Name="knob" Width="12" Height="12" Fill="#CCFFFFFF" HorizontalAlignment="Left" Margin="5,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="track" Property="BorderThickness" Value="0"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                <Setter TargetName="knob" Property="Width" Value="14"/>
                <Setter TargetName="knob" Property="Height" Value="14"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- parcali secim -->
    <Style x:Key="SegHost" TargetType="Border">
      <Setter Property="Background" Value="#33000000"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="6" Padding="12,6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- kaydirici -->
    <Style x:Key="RepeatNone" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RepeatFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Knob" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="20" Height="20">
              <Ellipse Fill="#FF2C2B33" Stroke="#3DFFFFFF"/>
              <Ellipse x:Name="dot" Width="10" Height="10" Fill="{StaticResource Accent}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="dot" Property="Width" Value="12"/>
                <Setter TargetName="dot" Property="Height" Value="12"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fluent" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Width" Value="220"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource RepeatFill}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource RepeatNone}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- butonlar -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="26,11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="8" Background="{StaticResource Accent}"/>
              <Border x:Name="h" CornerRadius="8" Background="#00FFFFFF"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="h" Property="Background" Value="#22FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="h" Property="Background" Value="#33000000"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- kartlar ve satirlar -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20,14"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="RowDesc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,24,0"/>
    </Style>
    <Style x:Key="RowIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Margin" Value="0,0,0,22"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Margin" Value="2,14,0,8"/>
    </Style>
    <Style x:Key="ValueLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="Key" TargetType="Border">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="BorderThickness" Value="1,1,1,2"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- pencere listesi -->
    <Style x:Key="WinItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" CornerRadius="6" Padding="12,8" Margin="0,1" Background="Transparent">
              <Grid>
                <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0"
                        Background="{StaticResource Accent}" Visibility="Collapsed"/>
                <ContentPresenter/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1AFFFFFF"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid TextElement.Foreground="{StaticResource Text}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= KENAR CUBUGU ================= -->
    <DockPanel Margin="14,16,10,16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,22">
        <Image x:Name="Logo" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Ambiance Ultrawide" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionText" Text="Sürüm 1.0" FontSize="11" Foreground="{StaticResource TextFaint}"/>
        </StackPanel>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" Margin="0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="SideDot" Width="8" Height="8" Fill="#66FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="SideStatus" Text="Kapalı" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" FontSize="11"/></Border>
            <Border Style="{StaticResource Key}"><TextBlock Text="Alt" FontSize="11"/></Border>
            <Border Style="{StaticResource Key}"><TextBlock Text="A" FontSize="11"/></Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel>
        <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Ana sayfa" IsChecked="True"/>
        <RadioButton x:Name="NavLight" Style="{StaticResource Nav}" Tag="&#xE706;" Content="Işık"/>
        <RadioButton x:Name="NavDisplay" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="Görüntü"/>
        <RadioButton x:Name="NavGeneral" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Genel"/>
        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Content="Hakkında"/>
      </StackPanel>
    </DockPanel>

    <!-- ================= SAYFALAR ================= -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="30,26,36,26" MaxWidth="820" HorizontalAlignment="Stretch">

        <!-- ANA SAYFA -->
        <StackPanel x:Name="PageHome">
          <TextBlock Style="{StaticResource PageTitle}" Text="Ana sayfa"/>
          <TextBlock Style="{StaticResource PageSub}" Text="Oyununu ultrawide ekranında keskin göster, boşluğu oyunun renkleriyle doldur."/>

          <Border Style="{StaticResource Card}" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="344" Height="144">
                <Grid.Clip><RectangleGeometry Rect="0,0,344,144" RadiusX="6" RadiusY="6"/></Grid.Clip>
                <Rectangle Fill="Black"/>
                <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                <Border x:Name="GameBox" Width="192" Height="108" Background="#FF0D0D11" BorderBrush="#33FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="OYUN" FontSize="11" FontWeight="SemiBold" Foreground="#4DFFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Margin="26,0,6,0" VerticalAlignment="Center">
                <Border x:Name="StatusPill" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Background="#1AFFFFFF">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Kapalı" FontSize="12"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="StatusTitle" Text="Başlamaya hazır" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusSub" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="13"
                           Text="Aşağıdan oyununu seç ya da oyundayken Ctrl&#x2060;+&#x2060;Alt&#x2060;+&#x2060;A'ya bas."/>
                <Button x:Name="StartBtn" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartIcon" FontFamily="{StaticResource Icons}" Text="&#xE768;" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StartText" Text="Başlat"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}" Padding="20,16,14,12">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Oyun penceresi"/>
                  <TextBlock Style="{StaticResource RowDesc}" Text="Oyunu pencereli ya da kenarlıksız (borderless) modda aç, sonra listeden seç."/>
                </StackPanel>
                <Button x:Name="RefreshBtn" Style="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72C;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Yenile"/>
                  </StackPanel>
                </Button>
              </Grid>
              <ListBox x:Name="WinList" Height="176" Background="Transparent" BorderThickness="0"
                       ItemContainerStyle="{StaticResource WinItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="13"/>
                      <TextBlock Grid.Column="1" Text="{Binding Info}" Foreground="#78FFFFFF" FontSize="12" Margin="16,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ISIK -->
        <StackPanel x:Name="PageLight" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Işık"/>
          <TextBlock Style="{StaticResource PageSub}" Text="Oyunun etrafındaki ambiyans ışığının görünümü."/>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE790;"/>
              <Border DockPanel.Dock="Right" Style="{StaticResource SegHost}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="StyleSoft" Style="{StaticResource Seg}" GroupName="style" Content="Sade"/>
                  <RadioButton x:Name="StyleDetail" Style="{StaticResource Seg}" GroupName="style" Content="Detaylı"/>
                </StackPanel>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Işık stili"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Sade: sadece renk. Detaylı: oyunun şekillerini de taşır."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE706;"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="BrightVal" Style="{StaticResource ValueLabel}" Text="%85"/>
                <Slider x:Name="BrightSlider" Style="{StaticResource Fluent}" Minimum="30" Maximum="140"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Parlaklık"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Işığın ne kadar güçlü yanacağı."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE916;"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="SpeedVal" Style="{StaticResource ValueLabel}" Text="4"/>
                <Slider x:Name="SpeedSlider" Style="{StaticResource Fluent}" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Tepki hızı"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Düşük: yumuşak ve sakin. Yüksek: sahneye anında uyar."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE9D9;"/>
              <Border DockPanel.Dock="Right" Style="{StaticResource SegHost}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Fps20" Style="{StaticResource Seg}" GroupName="fps" Content="20 FPS"/>
                  <RadioButton x:Name="Fps30" Style="{StaticResource Seg}" GroupName="fps" Content="30 FPS"/>
                  <RadioButton x:Name="Fps60" Style="{StaticResource Seg}" GroupName="fps" Content="60 FPS"/>
                </StackPanel>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Güncelleme hızı"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Işığın saniyede kaç kez yenileneceği. Düşük değer sistemi daha az yorar."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE81E;"/>
              <Border DockPanel.Dock="Right" Style="{StaticResource SegHost}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Feather0" Style="{StaticResource Seg}" GroupName="feather" Content="Kapalı"/>
                  <RadioButton x:Name="Feather32" Style="{StaticResource Seg}" GroupName="feather" Content="Az"/>
                  <RadioButton x:Name="Feather64" Style="{StaticResource Seg}" GroupName="feather" Content="Orta"/>
                  <RadioButton x:Name="Feather110" Style="{StaticResource Seg}" GroupName="feather" Content="Çok"/>
                </StackPanel>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Kenar geçişi"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Oyunun kenarını ışığa erittirir. Açıkken oyunun en dış kısmının üstüne biner."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- GORUNTU -->
        <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Görüntü"/>
          <TextBlock Style="{StaticResource PageSub}" Text="Oyun penceresinin boyutu ve ekranda büyütülmesi."/>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE740;"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Oyun penceresi boyutu"/>
                  <TextBlock Style="{StaticResource RowDesc}" Text="Başlatınca pencerenin kenarları kaldırılır ve tam bu boyuta getirilir. Büyük boyut daha fazla FPS harcar."/>
                </StackPanel>
              </DockPanel>
              <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left" Margin="36,12,0,2">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Size1920" Style="{StaticResource Seg}" GroupName="size" Content="1920 × 1080"/>
                  <RadioButton x:Name="Size2240" Style="{StaticResource Seg}" GroupName="size" Content="2240 × 1260"/>
                  <RadioButton x:Name="Size2400" Style="{StaticResource Seg}" GroupName="size" Content="2400 × 1350"/>
                  <RadioButton x:Name="Size2560" Style="{StaticResource Seg}" GroupName="size" Content="2560 × 1440"/>
                  <RadioButton x:Name="Size0" Style="{StaticResource Seg}" GroupName="size" Content="Dokunma"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8A0;"/>
              <CheckBox x:Name="CenterToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Pencereyi ortala"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Başlatınca oyun ekranın tam ortasına alınır."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Büyütme"/>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE71E;"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Görüntüyü büyüt"/>
                  <TextBlock Style="{StaticResource RowDesc}" Text="Oyun aynı sayıda piksel çizer, Windows ekranda büyük gösterir. FPS'e etkisi yoktur."/>
                </StackPanel>
              </DockPanel>
              <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left" Margin="36,12,0,2">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Zoom0" Style="{StaticResource Seg}" GroupName="zoom" Content="Kapalı"/>
                  <RadioButton x:Name="Zoom110" Style="{StaticResource Seg}" GroupName="zoom" Content="%110"/>
                  <RadioButton x:Name="Zoom120" Style="{StaticResource Seg}" GroupName="zoom" Content="%120"/>
                  <RadioButton x:Name="ZoomFit" Style="{StaticResource Seg}" GroupName="zoom" Content="Ekranı doldur"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7B3;"/>
              <CheckBox x:Name="SmoothZoomToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Yumuşak büyütme"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Kapalıyken pikseller olduğu gibi büyür (keskin). Açıkken kenarlar yumuşatılır."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}" Background="#14FF8A3D" BorderBrush="#33FF8A3D">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE946;" Foreground="#FFFFB37A"/>
              <TextBlock Style="{StaticResource RowDesc}" Margin="0" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                         Text="Büyütme açıkken menülerde fare imleci biraz kayabilir. Menüdeyken Ctrl&#x2060;+&#x2060;Alt&#x2060;+&#x2060;Z ile büyütmeyi kapatıp maçta tekrar açabilirsin."/>
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- GENEL -->
        <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Genel"/>
          <TextBlock Style="{StaticResource PageSub}" Text="Başlangıç, bildirimler ve kısayollar."/>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7E8;"/>
              <CheckBox x:Name="AutostartToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Windows ile başlat"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Bilgisayar açılınca saatin yanında sessizce başlar."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xEA8F;"/>
              <CheckBox x:Name="NotifyToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Bildirimler"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Uyarı ve ipuçlarını Windows bildirimi olarak göster."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Kısayollar"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,2,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" FontSize="12"/></Border>
                  <Border Style="{StaticResource Key}"><TextBlock Text="Alt" FontSize="12"/></Border>
                  <Border Style="{StaticResource Key}" Margin="0"><TextBlock Text="A" FontSize="12"/></Border>
                </StackPanel>
                <TextBlock Style="{StaticResource RowTitle}" Text="Ambiyans ışığını aç / kapat (o an aktif pencerede)" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,10"/>
              <DockPanel Margin="0,0,0,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" FontSize="12"/></Border>
                  <Border Style="{StaticResource Key}"><TextBlock Text="Alt" FontSize="12"/></Border>
                  <Border Style="{StaticResource Key}" Margin="0"><TextBlock Text="Z" FontSize="12"/></Border>
                </StackPanel>
                <TextBlock Style="{StaticResource RowTitle}" Text="Büyütmeyi anında aç / kapat" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Section}" Text="Sıfırla"/>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock Style="{StaticResource RowIcon}" Text="&#xE777;"/>
              <Button x:Name="ResetBtn" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Varsayılanlara dön"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Ayarları sıfırla"/>
                <TextBlock Style="{StaticResource RowDesc}" Text="Tüm ayarları ilk kurulumdaki haline getirir."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- HAKKINDA -->
        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Hakkında"/>
          <TextBlock Style="{StaticResource PageSub}" Text=" "/>
          <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Image x:Name="AboutLogo" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Ambiance Ultrawide" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                  <TextBlock x:Name="AboutVersion" Text="Sürüm 1.0 · Ücretsiz" Foreground="{StaticResource TextDim}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="22"
                         Text="Ultrawide monitörlerde düşük çözünürlükte oynanan oyunları bulanıklaştırmadan, piksel piksel net gösterir. Oyunun etrafındaki boşluğu, televizyonlardaki ambiyans ışığı gibi oyunun kendi renkleriyle doldurur."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE72E;"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="0" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           Text="Oyunun belleğine ya da dosyalarına dokunmaz. Sadece ekranda görünen görüntüyü okur."/>
              </DockPanel>
              <DockPanel Margin="0,8,0,4">
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE950;"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="0" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           Text="Görüntüyü ekran kartıyla yakalar. İşlemciye yükü çok düşüktür."/>
              </DockPanel>
              <DockPanel Margin="0,8,0,4">
                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7F4;"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="0" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           Text="Oyun pencereli ya da kenarlıksız (borderless) modda olmalıdır. Tam ekran modunda çalışmaz."/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
